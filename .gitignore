models/
build/
dist/
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.flac
*.mp3
*.onnx
*.bin
*.tar.bz2
*.tar.gz
*.zip
!content/**/*.yaml
!content/**/*.md

# --- python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- node ---
node_modules/

# --- os / editor ---
.DS_Store
Thumbs.db
*.swp
